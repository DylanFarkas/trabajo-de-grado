# OpenRouteService / HeiGIT API key
# Create one at https://account.heigit.org/
EXPO_PUBLIC_ORS_API_KEY=

# DeepSeek API key (MVP natural-language routes)
# Create one at https://platform.deepseek.com/
EXPO_PUBLIC_DEEPSEEK_API_KEY=
# Optional override (default: deepseek-chat)
# EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-chat

# Supabase (clave publicable del proyecto, no la secret)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Posición con la que se validan los reportes de vías cerradas.
# simulated (por defecto): cuenta la ubicación de prueba o el punto A, para probar sin estar en el campus.
# gps: solo cuenta la ubicación real del teléfono, con precisión de 30 m o mejor.
EXPO_PUBLIC_POSITION_MODE=simulated

# Auth de visitantes: correo y contraseña, sin confirmación.
# En el dashboard: Authentication > Providers > Email → Confirm email OFF.
# Google se queda solo en el admin.
